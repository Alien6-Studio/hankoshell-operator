  "features": [
    {
      "name": "Delegation and agent identity",
      "compatibility": "experimental",
      "limitation": "Typed intent is accepted; bounded provider execution is refused on both reviewed Keycloak versions.",
      "evidence": "docs/architecture/delegation-and-agent-identity.md"
    },
    {
      "name": "Second IAM provider",
      "compatibility": "experimental",
      "limitation": "Experimental authentik 2026.8.4 qualifies OIDC SPA/web registration only; all other domains and runtime credential delivery are refused. No production support or parity.",
      "evidence": "docs/architecture/provider-boundaries.md"
    },
    {
      "name": "Hub and Continuum",
      "compatibility": "alpha",
      "limitation": "Optional alpha integrations with signed plans, capability-aware delivery, disconnected recovery and installed six-cell Fleet evidence; no public connected-service compatibility promise.",
      "evidence": "docs/secure-deployment.md"
    },
    {
      "name": "Mesh traffic enforcement",
      "compatibility": "experimental",
      "limitation": "Registration and policy projection are audit-only; the operator does not enforce workload traffic.",
      "evidence": "docs/secure-deployment.md"
    },
    {
      "name": "Portable backup and restore",
      "compatibility": "experimental",
      "limitation": "Configuration capture and guarded database Job creation do not prove portable restore or database consistency.",
      "evidence": "docs/secure-deployment.md"
    },
    {
      "name": "Managed lifecycle",
      "compatibility": "experimental",
      "limitation": "Excluded from the stable 1.0 contract; disabled by default with independent UID/intent-bound approvals when enabled. Installed Clone qualifies only a configuration alias; managed Upgrade and DBSwitch remain unqualified.",
      "evidence": "docs/architecture/decisions/ADR-050-experimental-lifecycle-authority.md"
    },
    {
      "name": "Cloud, CNI and CSI",
      "compatibility": "experimental",
      "limitation": "API and kind fixtures do not qualify production cloud, networking or storage implementations.",
      "evidence": "docs/secure-deployment.md"
    }
  ],
