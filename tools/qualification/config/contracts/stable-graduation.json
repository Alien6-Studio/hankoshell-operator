  "criteria": {
    "conformance": {
      "threshold": "Every applicable frozen fixture passes with zero unaccepted lossy outcomes; unsupported outcomes remain explicit.",
      "evidence": "internal/iamconformance/testdata/portable-v1/corpus.json"
    },
    "installed": {
      "threshold": "Every supported Kubernetes/Keycloak cell passes the applicable installed scenarios on the candidate or a documented unchanged surface.",
      "evidence": "tools/qualification/scenarios/system_test.py"
    },
    "production": {
      "threshold": "At least two independent installations, two public operator releases and one real upgrade/rollback path for this resource; sanitized reports linked.",
      "evidence": "docs/production-evidence.md"
    },
    "ownership": {
      "threshold": "Zero unexpected foreign writes; UID recreation, cleanup, replay, restart and concurrent-writer negatives pass.",
      "evidence": "docs/architecture/existing-keycloak-adoption.md"
    },
    "compatibility": {
      "threshold": "Lossless served-version round trips and upgrade/rollback from every supported public predecessor; no unresolved pending-transaction loss.",
      "evidence": "docs/api-migration-policy.md"
    },
    "security": {
      "threshold": "Zero open Critical/High findings, all accepted findings reviewed, and stable-surface review at most 90 days old.",
      "evidence": "SECURITY.md"
    },
    "operations": {
      "threshold": "Every documented installation/recovery/rollback command has a named passing fixture, or is explicitly marked unqualified.",
      "evidence": "docs/secure-deployment.md"
    },
    "blockers": {
      "threshold": "Zero unresolved graduation blockers; explicit approval and community review recorded in #89/#104.",
      "evidence": "docs/public-contract-selection.md"
    }
  },
